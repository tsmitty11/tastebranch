{
  "name": "tastebranch",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build:css": "node scripts/fonts.mjs && tailwindcss -i assets/css/main.css -o static/css/main.css --minify",
    "build": "npm run build:css && hugo --minify",
    "dev": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/mona-sans": "^5.2.0",
    "@fontsource/inter": "^5.2.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/cli": "^4.1.0",
    "daisyui": "^5.0.0",
    "tailwindcss": "^4.1.0"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.6"
    }
  }
